# Cursor SDK is pinned by default; no automatic provider fallback.
KAMION_VLM_BACKEND=cursor
KAMION_CURSOR_MODEL=gpt-5.6-sol

# OpenAI. GPT-5.6 ships as three variants - luna, sol, terra - and there is no
# bare `gpt-5.6`. This is an opt-in alternative backend.
OPENAI_API_KEY=

# Cursor Agent SDK. Needs an API key from cursor.com/dashboard -> API & SSH Keys. The `cursor-agent` CLI login is a SESSION token and the SDK
# rejects it with "unauthenticated: Invalid User API Key". Cursor can also
# serve GPT models, so KAMION_CURSOR_MODEL can point at one.
CURSOR_API_KEY=

# Anthropic Messages API.
ANTHROPIC_API_KEY=

# Optional overrides
# KAMION_VLM_BACKEND=openai
# KAMION_OPENAI_MODEL=gpt-5.6-sol      # or gpt-5.6-luna (fastest), gpt-5.6-terra
# KAMION_OPENAI_EFFORT=low
# KAMION_ANTHROPIC_MODEL=claude-opus-5
# KAMION_ANTHROPIC_EFFORT=low
# SDK model ID verified with Cursor.models.list(); low reasoning is passed separately.
# KAMION_MAX_EVIDENCE_PHOTOS=14

# Optional authorized vehicle-history snapshot; see docs/vehicle-history.md.
# KAMION_HISTORY_DB=/absolute/path/vehicle-history.json

# Off by default: preserve demo latency/pricing until history is validated.
KAMION_HISTORY_ENABLED=0
