# Vision backend credentials. The first backend in the chain that authenticates
# wins; KAMION_VLM_BACKEND pins one explicitly.

# OpenAI. GPT-5.6 ships as three variants - luna, sol, terra - and there is no
# bare `gpt-5.6`. This is the default backend.
OPENAI_API_KEY=

# Cursor Agent SDK. Needs an API key from cursor.com/dashboard -> Integrations
# -> API Keys. The `cursor-agent` CLI login is a SESSION token and the SDK
# rejects it with "unauthenticated: Invalid User API Key". Cursor can also
# serve GPT models, so KAMION_CURSOR_MODEL can point at one.
CURSOR_API_KEY=

# Anthropic Messages API.
ANTHROPIC_API_KEY=

# Optional overrides
# KAMION_VLM_BACKEND=openai
# KAMION_OPENAI_MODEL=gpt-5.6-sol      # or gpt-5.6-luna (fastest), gpt-5.6-terra
# KAMION_OPENAI_EFFORT=low
# KAMION_ANTHROPIC_MODEL=claude-opus-5
# KAMION_ANTHROPIC_EFFORT=low
# KAMION_CURSOR_MODEL=claude-4.5-sonnet
# KAMION_MAX_EVIDENCE_PHOTOS=14
