# Dataset images (several GB, rebuildable via scripts/).
# Everything else under data/ is committed, so the bundle's metadata travels
# with the repo and only the pixels have to be shared out of band.
data/images/

# Tooling caches and session artifacts
.firecrawl/
.playwright-mcp/

# macOS
.DS_Store

# Python
.venv/
__pycache__/
*.pyc

# Demo fixtures are rebuilt from the corpus: python -m app.demo --build
demo/

# Local run artifacts
runs/

# Local provider credentials
.env
.env.*
!.env.example
# A bare `env` is not what config.py reads (it loads `.env`), but it turns up as
# a stray holding real keys - keep it from ever being committed.
/env

# Exported offline reports (rebuild: python -m app.demo --export demo_reports/)
demo_reports/

# Derived CLIP embedding cache (14 MB, rebuild: python scripts/cache_embeddings.py)
data/metadata/embeddings.npz

# The eval harness. The response cache is rebuildable and ~15 MB per model; the
# scorecards are the record and must travel with the repo, so `eval/runs/` is
# re-included past the blanket `runs/` rule above.
eval/cache/
!eval/runs/

# Detector benchmark candidates. `scripts/benchmark_detector.py` re-downloads
# these from ultralytics when they are absent, so 140 MB of reproducible
# weights would be pure history. The gate's own yolov8n.pt is tracked
# deliberately - it is what the app runs, not a benchmark candidate.
/models/*.pt
!/models/yolov8n.pt
